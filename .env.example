# 이 파일을 복사해서 .env 를 만들고 값을 채우세요. (.env 는 git에 올라가지 않습니다)

# Supabase 대시보드 → Project Settings → API (또는 Connect 버튼)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# publishable 키(sb_publishable_...) 또는 legacy "anon public" 키
# 절대 secret 키(sb_secret_...)나 service_role 키를 넣지 마세요. RLS를 우회합니다. (앱이 시작 시 거부함)
SUPABASE_ANON_KEY=

# 로그인 세션 쿠키 서명용 임의의 긴 문자열. 아래 명령으로 만들 수 있습니다:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
